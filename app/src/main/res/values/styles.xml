<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ContactsV3" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Chaque fragment affiche son propre titre : aucune barre d'action
             ne peut recouvrir le contenu, y compris sous Android 15. -->
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="TitreFragment">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#FF3F51B5</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
